{
  "name": "emmyconceptng/laravel-ng-postcode",
  "description": "Parse, validate and format Nigeria's NIPOST digital postcode in Laravel.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Emmanurl O Kolawole",
      "email": "emmyconceptng@gmail.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "illuminate/contracts": "^10.0|^11.0|^12.0"
  },
  "autoload": {
    "psr-4": {
      "EmmanuelKolawole\\NgPostcode\\": "src/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^13.4",
    "illuminate/validation": "^10.0|^11.0|^12.0",
    "illuminate/translation": "^10.0|^11.0|^12.0"
  },
  "autoload-dev": {
    "psr-4": {
      "EmmanuelKolawole\\NgPostcode\\Tests\\": "tests/"
    }
  }
}
