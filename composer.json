{
  "name": "emmyconceptng/laravel-ng-postcode",
  "description": "Parse, validate and format Nigeria's NIPOST digital postcode in Laravel.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Emmanuel O. Kolawole",
      "email": "emmyconceptng@gmail.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "illuminate/contracts": "^12.0|^13.0",
    "illuminate/support": "^12.0|^13.0"
  },
  "autoload": {
    "psr-4": {
      "EmmanuelKolawole\\NgPostcode\\": "src/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5|^12.0|^13.0",
    "illuminate/validation": "^12.0|^13.0",
    "illuminate/translation": "^12.0|^13.0",
    "orchestra/testbench": "^10.0|^11.0"
  },
  "autoload-dev": {
    "psr-4": {
      "EmmanuelKolawole\\NgPostcode\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "EmmanuelKolawole\\NgPostcode\\NgPostcodeServiceProvider"
      ]
    }
  }
}
